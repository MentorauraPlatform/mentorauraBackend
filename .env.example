# ─────────────────────────────────────────────────────────────────────────────
# Mentoraura Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.opopvxzurkuqilzctser:mentoraurapasswor@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.opopvxzurkuqilzctser:mentoraurapasswor@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=change-me-to-another-long-secret
JWT_REFRESH_EXPIRY=7d

# ── Object Storage (S3-compatible) ────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=mentoraura-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mentoraura.com

# ── ZoPay Mobile Money Payment Gateway ────────────────────────────────────────
# Base API URL: https://sandbox.zopay.co (testing) or https://api.zopay.co (production)
ZOPAY_BASE_URL=https://sandbox.zopay.co

# Merchant API Credentials (from ZoPay Dashboard > Settings > API Keys)
ZOPAY_API_KEY=
ZOPAY_SECRET_KEY=

# Webhook Secret (from ZoPay Dashboard > Webhooks)
ZOPAY_WEBHOOK_SECRET=

# Merchant Origin/Domain (must match your registered/allowlisted origin in ZoPay)
ZOPAY_ORIGIN=http://localhost:3000

# Legacy webhook secret (fallback)
PAYMENT_WEBHOOK_SECRET=change-me


# ── KYC Provider ─────────────────────────────────────────────────────────────
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_BASE_URL=

# ── Video Conferencing ────────────────────────────────────────────────────────
# MVP uses Google Meet / Zoom links — no embedded video infra
GOOGLE_MEET_OAUTH_CLIENT_ID=
GOOGLE_MEET_OAUTH_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

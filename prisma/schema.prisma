generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MENTEE
  MENTOR
  ADMIN
  SUPER_ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum OnboardingStatus {
  INCOMPLETE
  PENDING
  COMPLETE
}

enum MentorshipStatus {
  INTRO
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MentorshipApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MTN_MOMO
  ORANGE_MONEY
  CARD
  BANK
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_REJECTED
  RESOLVED_RESCHEDULED
  CLOSED
}

enum DisputeReason {
  SESSION_NO_SHOW
  POOR_QUALITY
  UNAUTHORIZED_CHARGE
  MENTOR_UNRESPONSIVE
  SCHEDULING_CONFLICT
  OTHER
}

enum ModerationTargetType {
  MESSAGE
  USER_PROFILE
  REVIEW
}

enum ModerationStatus {
  PENDING
  ACTION_TAKEN
  DISMISSED
}

model Skill {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique @db.VarChar(255)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userSkills UserSkill[]

  @@index([name], map: "idx_skills_name")
  @@map("skills")
}

model UserSkill {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  skillId   String     @map("skill_id") @db.Uuid
  level     SkillLevel @default(BEGINNER)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, skillId], map: "uq_user_skill")
  @@index([userId], map: "idx_user_skills_user_id")
  @@index([skillId], map: "idx_user_skills_skill_id")
  @@map("user_skills")
}

model User {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String         @unique @db.VarChar(255)
  passwordHash              String         @map("password_hash") @db.VarChar(255)
  role                      UserRole       @default(MENTEE)
  isMentor                  Boolean        @default(false) @map("is_mentor")
  isActive                  Boolean        @default(true) @map("is_active")
  isEmailVerified           Boolean        @default(false) @map("is_email_verified")
  emailVerificationToken    String?        @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpires  DateTime?      @map("email_verification_expires") @db.Timestamptz(6)
  passwordResetOtpHash      String?        @map("password_reset_otp_hash") @db.VarChar(255)
  passwordResetOtpExpires   DateTime?      @map("password_reset_otp_expires") @db.Timestamptz(6)
  passwordResetOtpAttempts  Int            @default(0) @map("password_reset_otp_attempts")
  invitationToken           String?        @map("invitation_token") @db.VarChar(255)
  invitationExpires         DateTime?      @map("invitation_expires") @db.Timestamptz(6)
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  menteeProfile MenteeProfile?
  mentorProfile MentorProfile?
  userSkills    UserSkill[]
  mentorships   Mentorship[]   @relation("MenteeMentorships")
  payments      Payment[]
  reviews       Review[]
  sessions      Session[]      @relation("MenteeSessions")
  applications  MentorshipApplication[] @relation("MenteeApplications")
  bookings      Booking[]      @relation("MenteeBookings")
  adminAuditLogs AdminAuditLog[]
  conversationsAsParticipant1 Conversation[] @relation("ConvParticipant1")
  conversationsAsParticipant2 Conversation[] @relation("ConvParticipant2")
  messages                    Message[]      @relation("UserMessages")
  raisedDisputes              Dispute[]      @relation("RaisedDisputes")
  targetDisputes              Dispute[]      @relation("TargetDisputes")
  moderationReports           ModerationReport[] @relation("UserReports")

  @@index([email], map: "idx_users_email")
  @@map("users")
}

model AdminAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String   @db.VarChar(100)
  targetId  String   @map("target_id") @db.Uuid
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_audit_logs")
}

model MenteeProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  fullName            String   @map("full_name") @db.VarChar(255)
  avatarUrl           String?  @map("avatar_url") @db.VarChar(512)
  headline            String?  @db.VarChar(255)
  goals               String[] @default([])
  interests           String[] @default([])
  currentRole         String?  @map("current_role") @db.VarChar(255)
  educationBackground String?  @map("education_background") @db.Text
  yearsOfExperience   Int?     @map("years_of_experience")
  experienceLevel     String?  @map("experience_level") @db.VarChar(32)
  availability        Json?
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_mentee_profiles_user_id")
  @@map("mentee_profiles")
}
model MentorProfile {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @unique @map("user_id") @db.Uuid
  fullName          String           @map("full_name") @db.VarChar(255)
  slug              String?          @unique @db.VarChar(255)
  title             String           @db.VarChar(255)
  headline          String?          @db.VarChar(255)
  company           String?          @db.VarChar(255)
  bio               String?
  experience        String?
  yearsOfExperience Int?             @map("years_of_experience")
  linkedinUrl       String?          @map("linkedin_url") @db.VarChar(512)
  githubUrl         String?          @map("github_url") @db.VarChar(512)
  idDocumentUrl     String?          @map("id_document_url") @db.VarChar(512)
  cvUrl             String?          @map("cv_url") @db.VarChar(512)
  areasOfExpertise  String[]         @default([]) @map("areas_of_expertise")
  availability      Json?
  onboardingStatus  String           @default("INCOMPLETE") @map("onboarding_status")
  isVerified        Boolean          @default(false) @map("is_verified")
  rejectionReason   String?          @map("rejection_reason") @db.Text
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mentorships      Mentorship[]     @relation("MentorMentorships")
  plans            Plan[]
  reviews          Review[]         @relation("MentorReviews")
  sessions         Session[]        @relation("MentorSessions")
  mentorCategories MentorCategory[]
  applications     MentorshipApplication[] @relation("MentorApplications")
  blackoutDates    BlackoutDate[]
  bookings         Booking[]        @relation("MentorBookings")
  payouts          Payout[]

  @@index([userId], map: "idx_mentor_profiles_user_id")
  @@map("mentor_profiles")
}

model Category {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String           @unique @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  description      String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  mentorCategories MentorCategory[]

  @@map("categories")
}

model MentorCategory {
  mentorProfileId String        @map("mentor_profile_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([mentorProfileId, categoryId])
  @@map("mentor_categories")
}

model Plan {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId         String        @map("mentor_id") @db.Uuid
  title            String        @db.VarChar(255)
  description      String?
  priceAmount      BigInt        @map("price_amount")
  currency         String        @default("XAF") @db.VarChar(10)
  sessionsPerMonth Int           @default(1) @map("sessions_per_month")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  mentorships      Mentorship[]
  applications     MentorshipApplication[] @relation("PlanApplications")
  mentor           MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mentorId], map: "idx_plans_mentor_id")
  @@map("plans")
}

model Mentorship {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menteeId           String           @map("mentee_id") @db.Uuid
  mentorId           String           @map("mentor_id") @db.Uuid
  planId             String           @map("plan_id") @db.Uuid
  status             MentorshipStatus @default(INTRO)
  cancellationReason String?          @map("cancellation_reason") @db.Text
  startedAt          DateTime?        @map("started_at") @db.Timestamptz(6)
  endedAt            DateTime?        @map("ended_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  mentee    User          @relation("MenteeMentorships", fields: [menteeId], references: [id], onUpdate: NoAction)
  mentor    MentorProfile @relation("MentorMentorships", fields: [mentorId], references: [id], onUpdate: NoAction)
  plan      Plan          @relation(fields: [planId], references: [id], onUpdate: NoAction)
  payments  Payment[]
  reviews   Review[]
  sessions  Session[]
  bookings  Booking[]
  conversation Conversation?
  disputes  Dispute[]

  @@index([menteeId], map: "idx_mentorships_mentee")
  @@index([mentorId], map: "idx_mentorships_mentor")
  @@map("mentorships")
}

model MentorshipApplication {
  id        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menteeId  String                     @map("mentee_id") @db.Uuid
  mentorId  String                     @map("mentor_id") @db.Uuid
  planId    String                     @map("plan_id") @db.Uuid
  message   String?                     @db.Text
  status    MentorshipApplicationStatus @default(PENDING)
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  mentee User          @relation("MenteeApplications", fields: [menteeId], references: [id], onUpdate: NoAction)
  mentor MentorProfile @relation("MentorApplications", fields: [mentorId], references: [id], onUpdate: NoAction)
  plan   Plan          @relation("PlanApplications", fields: [planId], references: [id], onUpdate: NoAction)

  @@index([menteeId], map: "idx_applications_mentee")
  @@index([mentorId], map: "idx_applications_mentor")
  @@index([planId], map: "idx_applications_plan")
  @@map("mentorship_applications")
}

model Session {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorshipId    String        @map("mentorship_id") @db.Uuid
  mentorId        String        @map("mentor_id") @db.Uuid
  menteeId        String        @map("mentee_id") @db.Uuid
  scheduledAt     DateTime      @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int           @default(60) @map("duration_minutes")
  status          BookingStatus @default(SCHEDULED)
  meetingLink     String?       @map("meeting_link") @db.VarChar(512)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  mentee          User          @relation("MenteeSessions", fields: [menteeId], references: [id], onUpdate: NoAction)
  mentor          MentorProfile @relation("MentorSessions", fields: [mentorId], references: [id], onUpdate: NoAction)
  mentorship      Mentorship    @relation(fields: [mentorshipId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mentorshipId], map: "idx_sessions_mentorship")
  @@index([scheduledAt], map: "idx_sessions_scheduled_at")
  @@map("sessions")
}

model Booking {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorshipId      String        @map("mentorship_id") @db.Uuid
  mentorId          String        @map("mentor_id") @db.Uuid
  menteeId          String        @map("mentee_id") @db.Uuid
  scheduledAt       DateTime      @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes   Int           @default(60) @map("duration_minutes")
  status            BookingStatus @default(SCHEDULED)
  meetingLink       String?       @map("meeting_link") @db.VarChar(512)
  cancellationReason String?     @map("cancellation_reason") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mentee      User       @relation("MenteeBookings", fields: [menteeId], references: [id], onUpdate: NoAction)
  mentor      MentorProfile @relation("MentorBookings", fields: [mentorId], references: [id], onUpdate: NoAction)
  disputes    Dispute[]

  @@index([mentorId, scheduledAt], map: "idx_bookings_mentor_scheduled")
  @@index([mentorshipId], map: "idx_bookings_mentorship")
  @@unique([mentorId, scheduledAt], map: "unique_mentor_slot")
  @@map("bookings")
}

model BlackoutDate {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorProfileId String        @map("mentor_profile_id") @db.Uuid
  date            DateTime      @db.Date
  reason          String?       @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([mentorProfileId, date], map: "uq_blackout_mentor_date")
  @@index([mentorProfileId], map: "idx_blackouts_mentor")
  @@map("blackout_dates")
}

model Payment {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorshipId      String     @map("mentorship_id") @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  amount            BigInt
  currency          String     @default("XAF") @db.VarChar(10)
  provider          String     @db.VarChar(32)
  status            String     @default("PENDING") @db.VarChar(32)
  providerReference String?    @map("provider_reference") @db.VarChar(255)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  mentorship        Mentorship @relation(fields: [mentorshipId], references: [id], onUpdate: NoAction)
  user              User       @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([mentorshipId], map: "idx_payments_mentorship")
  @@index([providerReference], map: "idx_payments_provider_ref")
  @@map("payments")
}

model Review {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorshipId String        @map("mentorship_id") @db.Uuid
  reviewerId   String        @map("reviewer_id") @db.Uuid
  mentorId     String        @map("mentor_id") @db.Uuid
  rating       Int
  comment      String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  mentor       MentorProfile @relation("MentorReviews", fields: [mentorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mentorship   Mentorship    @relation(fields: [mentorshipId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer     User          @relation(fields: [reviewerId], references: [id], onUpdate: NoAction)

  @@index([mentorId], map: "idx_reviews_mentor")
  @@map("reviews")
}

model Conversation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorshipId   String?      @unique @map("mentorship_id") @db.Uuid
  participant1Id String       @map("participant1_id") @db.Uuid
  participant2Id String       @map("participant2_id") @db.Uuid
  lastMessageAt  DateTime     @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentorship     Mentorship?  @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  participant1   User         @relation("ConvParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User         @relation("ConvParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participant1Id, participant2Id], map: "uq_conversation_participants")
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([mentorshipId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @db.Text
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Payout {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId        String       @map("mentor_id") @db.Uuid
  amount          BigInt
  currency        String       @default("XAF") @db.VarChar(10)
  provider        String       @db.VarChar(32) // MTN_MOMO, ORANGE_MONEY, BANK_TRANSFER
  accountNumber   String       @map("account_number") @db.VarChar(100)
  accountName     String?      @map("account_name") @db.VarChar(255)
  status          PayoutStatus @default(PENDING)
  transactionRef  String?      @map("transaction_ref") @db.VarChar(255)
  rejectionReason String?      @map("rejection_reason") @db.Text
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mentor          MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([status])
  @@map("payouts")
}

model Dispute {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorshipId    String?       @map("mentorship_id") @db.Uuid
  bookingId       String?       @map("booking_id") @db.Uuid
  raisedById      String        @map("raised_by_id") @db.Uuid
  targetUserId    String?       @map("target_user_id") @db.Uuid
  reason          DisputeReason @default(OTHER)
  title           String        @db.VarChar(255)
  description     String        @db.Text
  status          DisputeStatus @default(OPEN)
  resolutionNotes String?       @map("resolution_notes") @db.Text
  resolvedAt      DateTime?     @map("resolved_at") @db.Timestamptz(6)
  refundAmount    BigInt?       @map("refund_amount")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  raisedBy        User          @relation("RaisedDisputes", fields: [raisedById], references: [id], onDelete: Cascade)
  targetUser      User?         @relation("TargetDisputes", fields: [targetUserId], references: [id], onDelete: SetNull)
  mentorship      Mentorship?   @relation(fields: [mentorshipId], references: [id], onDelete: SetNull)
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([raisedById])
  @@index([status])
  @@map("disputes")
}

model ModerationReport {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId  String               @map("reporter_id") @db.Uuid
  targetType  ModerationTargetType @map("target_type")
  targetId    String               @map("target_id") @db.Uuid
  reason      String               @db.VarChar(255)
  details     String?              @db.Text
  status      ModerationStatus     @default(PENDING)
  actionTaken String?              @map("action_taken") @db.VarChar(100)
  notes       String?              @db.Text
  resolvedAt  DateTime?            @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  reporter    User                 @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
  @@index([targetType])
  @@map("moderation_reports")
}

model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}
